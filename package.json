{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Solomon Olatunji",
  "description": "Solomon Olatunji's personal portfolio website",
  "email": "me@solomonolatunji.com",
  "scripts": {
    "dev": "npm run build && CLOUDFLARE_CF_FETCH_ENABLED=false wrangler pages dev",
    "dev:nuxt": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "deploy": "nuxi build --preset=cloudflare_pages && wrangler pages deploy dist",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/seo": "^5.3.12",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/wasm": "^2.9.2",
    "@tanstack/vue-query": "^5.101.4",
    "@vueform/vueform": "^1.13.13",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.7.8",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.123.0"
  }
}
